NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — enables real exercise GIFs + videos on the Workout screen.
# Get a key from RapidAPI (ExerciseDB / "EDB with videos and images by AscendAPI").
# Server-only (NOT NEXT_PUBLIC) so it never reaches the browser.
RAPIDAPI_KEY=YOUR-RAPIDAPI-KEY
# RAPIDAPI_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com

# Optional — enables the AI coach (Groq). Server-only (NOT NEXT_PUBLIC).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=YOUR-GROQ-KEY
# GROQ_MODEL=llama-3.3-70b-versatile
