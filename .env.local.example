NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — enables real exercise GIFs + videos on the Workout screen.
# Get a key from RapidAPI (ExerciseDB / "EDB with videos and images by AscendAPI").
# Server-only (NOT NEXT_PUBLIC) so it never reaches the browser.
RAPIDAPI_KEY=YOUR-RAPIDAPI-KEY
# RAPIDAPI_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com

# Optional — enables the AI coach (Groq). Server-only (NOT NEXT_PUBLIC).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=YOUR-GROQ-KEY
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional — background push reminders + weekly AI check-in.
# Generate keys once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
# Service role key (Supabase → Settings → API) so the cron can read subscriptions. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Protects the cron endpoints; set the same value in Vercel.
CRON_SECRET=YOUR-RANDOM-SECRET
